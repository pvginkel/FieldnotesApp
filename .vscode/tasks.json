{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "scripts/dev.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "icon": { "id": "server" },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "showReuseMessage": true
      },
      "runOptions": {
        "reevaluateOnRerun": true,
        "instanceLimit": 999
      },
      "isBackground": true
    }
  ]
}
