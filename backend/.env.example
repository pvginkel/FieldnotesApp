# fieldnotes Environment Configuration
#
# Copy this file to .env and update values as needed.
# All values shown are defaults.

# ── Core Settings ─────────────────────────────────────────────────────

# Flask environment: development, testing, production
FLASK_ENV=development

# Deployment tier: local-dev, dev, uat, prd, local-tst or tst. Unset, it is
# local-dev under FLASK_ENV=development, local-tst under testing, else prd.
# STAGE=local-dev

# An internal app shows internal detail (exception text in 500 responses, the
# frontend's diagnostics) even on prd. Every STAGE but prd shows it anyway.
HOMELAB_INTERNAL=false

# Debug mode (disable in production)
DEBUG=true

# Secret key for Flask sessions (MUST be changed in production)
SECRET_KEY=dev-secret-key-change-in-production

# Allowed CORS origins (comma-separated in env, JSON list in code)
CORS_ORIGINS=["http://localhost:3400"]

# Root log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. The API's only one:
# it ignores FIELDNOTES_LOG_LEVEL, which is the MCP server's.
LOG_LEVEL=INFO

# Largest request body accepted, in MB; a larger one gets 413. The frontend's
# nginx stops bodies over 50 MB (client_max_body_size) before they get here.
MAX_UPLOAD_SIZE_MB=50

# ── Background Tasks ─────────────────────────────────────────────────

# Maximum number of concurrent background task workers
TASK_MAX_WORKERS=4

# Task execution timeout in seconds
TASK_TIMEOUT_SECONDS=300

# How often to clean up completed tasks (seconds)
TASK_CLEANUP_INTERVAL_SECONDS=600

# ── Metrics ───────────────────────────────────────────────────────────

# Background metrics update interval in seconds
METRICS_UPDATE_INTERVAL=60

# ── Shutdown ──────────────────────────────────────────────────────────

# Maximum seconds to wait for tasks during graceful shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=600

# Bearer token for authenticating drain endpoint access
DRAIN_AUTH_KEY=

# ── OIDC Authentication (use_oidc) ───────────────────────────────────

# Base URL for the application. It infers OIDC_COOKIE_SECURE; the OIDC
# redirect URIs come from the origin each request came in on.
BASEURL=http://localhost:3400

# Enable/disable OIDC authentication
OIDC_ENABLED=false

# OIDC provider settings
OIDC_ISSUER_URL=https://auth.example.com/realms/myapp
OIDC_CLIENT_ID=my-backend
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_AUDIENCE=

# Token validation
OIDC_CLOCK_SKEW_SECONDS=30

# Cookie settings
OIDC_COOKIE_NAME=access_token
OIDC_COOKIE_SECURE=
OIDC_COOKIE_SAMESITE=Lax
OIDC_REFRESH_COOKIE_NAME=refresh_token

# ── Server-Sent Events (use_sse) ─────────────────────────────────────

# URL to fetch frontend version information
FRONTEND_VERSION_URL=http://localhost:3400/version.json

# SSE heartbeat interval in seconds (5 for dev, 30 for production auto)
SSE_HEARTBEAT_INTERVAL=5

# Events an SSE connection queues before it counts as stalled and is closed
SSE_QUEUE_MAX_FRAMES=1000
