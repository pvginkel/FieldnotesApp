// Architecture producer pipeline for the federated Architecture-as-Code model: this repo
// publishes Fieldnotes' logical architecture as producer `fieldnotes-app`.
//
// The artifact, docs/architecture/*.yaml, is hand-authored, so the pipeline only validates and
// archives it: there is no generator, no dataset fetch and no Vault credential. The agent needs
// outbound HTTPS to architecture.webathome.org for validation.

library identifier: 'JenkinsPipelineUtils', changelog: false

podTemplate(inheritFrom: 'jenkins-agent', containers: [
    containerTemplates.aac_tools('aac-tools')
]) {
    node(POD_LABEL) {
        stage('Cloning repo') {
            checkout scm
        }

        stage('Validate architecture') {
            container('aac-tools') {
                sh 'arch-validate docs/architecture/*.yaml'
            }
            archiveArtifacts artifacts: 'docs/architecture/*.yaml', fingerprint: true
        }
    }
}
