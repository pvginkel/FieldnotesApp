# What the dev pipeline reads about this project.
# Schema: ${CLAUDE_PLUGIN_ROOT}/docs/project-contract.md

spec_repo = "../FieldnotesAppSpecs"
design_philosophy = "docs/change-discipline.md"

[test_phase]
# Local verification first, then the push, which builds and rolls production:
# there is one deployment and no dev instance. The doc says which deployed
# checks a slice owes and how to clear what they write.
strategy = "docs/slice-test-plan.md"

[doc_phase]
plan = "docs/slice-doc-plan.md"

[push]
enabled = true

# No [devlock]: there is no dev instance to occupy, and a deployed check holds
# nothing for its length.
